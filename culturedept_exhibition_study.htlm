  },
  {
    type: "step",
    step: "4",
    title: "작가의 의도 유추하기",
    content: "작가가 가진 가치관과 거쳐온 삶을 토대로 내가 작가라면 이 작품을 어떤 의도로 만들었을지 유추해 봅니다.\n\n단순히 표현의 탐구였을까요? 감정의 표출일까요? 어떤 감정일까요? 메시지를 전달하고 싶었을까요? 어떤 메시지일까요?"
  },
  {
    type: "step",
    step: "5",
    title: "작가의 의도 확인하기",
    content: "이제 텍스트를 읽고 작가의 의도와 나의 예상을 비교해 봅니다.\n\n같을 필요 없고, 같을 수도 없습니다."
  },
  {
    type: "step",
    step: "6",
    title: "전시에 대한 주관적인\n평가와 피드백",
    content: "위에 적은 내용을 토대로 종합적인 작품에 대한 주관적인 평가와 나라면 어떻게 했을지 피드백을 적어봅니다.\n\n의도가 나에게 전달되지 않았다면 어떤 표현이 문제였는지, 나라면 어떻게 표현했을지 적어봅니다.\n\n표현이, 표현과 표현의 조합이 어떤 느낌을 만들어내는지 새롭게 알게 된 사실을 기록합니다."
  },
  {
    type: "simple",
    title: "문화부원으로서의\n전시 관람 자세",
    content: "문화부는 어떤 사명일까요? 우리는 표현 방식을 탐구하는 사명이 아니라 하늘의 뜻을 표현에 담아 전달해야 하는 사명입니다. 하늘의 것은 좋게 느끼게 하고, 사단의 것은 안 좋게 느끼게 해야 합니다. 느낌을 의도하고 표현을 계산할 줄 알아야 합니다.\n\n전시를 관람한다는 것은 내가 사용해보지 못한 표현들, 내가 경험해보지 못한 표현들과 표현과 표현의 조합에 대한 선례를 보는 일입니다. 선례를 통해 느낌말들을 수집하고 교회와 전도 현장에서 있어지는 다양한 상황들 속 다양한 마음 가운데 하나님의 말씀을 좋은 느낌으로 전달할 수 있도록 고민하고 적용해 봅시다.\n\n세상의 작품은 부정적인 감정과 느낌을 다루는 경우가 많습니다. 무분별하게 멋지다, 힙하다라고 생각하지 않고 비판적으로 하늘문화에 적용할 수 있는지 생각하며 평가하면 좋을 것입니다. 또한 밝고 긍정적인 감정을 다루는 작품이 있다면 잘 분석하고 기록하여 참고해야 할 것입니다."
  },
  {
    type: "title",
    title: "마치는 말",
    content: "",
    sub: "발표자의 경험을 기반한 주관적인 교육입니다. 절대적으로 따를 필요는 없지만 각자의 사명에 좋은 참고가 되었길 바라며 교육을 마칩니다."
  }
];

export default function App() {
  const [currentSlide, setCurrentSlide] = useState(0);
  const [direction, setDirection] = useState(0);
  const [isMenuOpen, setIsMenuOpen] = useState(false);
  const touchStart = useRef(null);
  const touchEnd = useRef(null);

  const totalSlides = slidesData.length;

  const nextSlide = () => {
    if (currentSlide < totalSlides - 1) {
      setDirection(1);
      setCurrentSlide(curr => curr + 1);
    }
  };

  const prevSlide = () => {
    if (currentSlide > 0) {
      setDirection(-1);
      setCurrentSlide(curr => curr - 1);
    }
  };

  const goToSlide = (index) => {
    setDirection(index > currentSlide ? 1 : -1);
    setCurrentSlide(index);
    setIsMenuOpen(false);
  };

  // Keyboard navigation
  useEffect(() => {
    const handleKeyDown = (e) => {
      if (e.key === 'ArrowRight' || e.key === 'Space') nextSlide();
      if (e.key === 'ArrowLeft') prevSlide();
    };
    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, [currentSlide]);

  // Touch navigation
  const onTouchStart = (e) => {
    touchEnd.current = null;
    touchStart.current = e.targetTouches[0].clientX;
  };

  const onTouchMove = (e) => {
    touchEnd.current = e.targetTouches[0].clientX;
  };

  const onTouchEnd = () => {
    if (!touchStart.current || !touchEnd.current) return;
    const distance = touchStart.current - touchEnd.current;
    const isLeftSwipe = distance > 50;
    const isRightSwipe = distance < -50;

    if (isLeftSwipe) nextSlide();
    if (isRightSwipe) prevSlide();
  };

  return (
    <div 
      className="relative w-full h-screen overflow-hidden bg-white text-black font-sans selection:bg-black selection:text-white"
      onTouchStart={onTouchStart}
      onTouchMove={onTouchMove}
      onTouchEnd={onTouchEnd}
    >
      {/* Progress Bar */}
      <div className="absolute top-0 left-0 w-full h-1 bg-gray-100 z-50">
        <div 
          className="h-full bg-black transition-all duration-300 ease-out"
          style={{ width: `${((currentSlide + 1) / totalSlides) * 100}%` }}
        />
      </div>

      {/* Header / Nav */}
      <header className="absolute top-0 left-0 w-full p-6 flex justify-between items-center z-40 bg-white/80 backdrop-blur-sm">
        <div className="text-xs font-bold tracking-widest uppercase">
          Cultural Dept. Guide
        </div>
        <button 
          onClick={() => setIsMenuOpen(true)}
          className="p-2 hover:bg-gray-100 rounded-full transition-colors"
        >
          <Menu size={24} />
        </button>
      </header>

      {/* Menu Overlay */}
      {isMenuOpen && (
        <div className="fixed inset-0 z-50 bg-white flex flex-col p-8 animate-fade-in">
          <div className="flex justify-end mb-8">
            <button onClick={() => setIsMenuOpen(false)} className="p-2 hover:bg-gray-100 rounded-full">
              <X size={32} />
            </button>
          </div>
          <nav className="flex-1 overflow-y-auto">
            <ul className="space-y-4">
              {slidesData.map((slide, idx) => (
                <li key={idx}>
                  <button 
                    onClick={() => goToSlide(idx)}
                    className={`text-2xl font-bold text-left w-full hover:translate-x-2 transition-transform ${currentSlide === idx ? 'text-black' : 'text-gray-300'}`}
                  >
                    <span className="text-sm mr-4 text-gray-400 font-normal align-middle">
                      {(idx + 1).toString().padStart(2, '0')}
                    </span>
                    {slide.title.replace(/\n/g, ' ')}
                  </button>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      )}

      {/* Main Content Area */}
      <main className="w-full h-full flex items-center justify-center relative px-6 md:px-20">
        <div className="w-full max-w-6xl mx-auto">
          {slidesData.map((slide, index) => (
            <div
              key={index}
              className={`absolute inset-0 w-full h-full flex flex-col justify-center transition-all duration-700 ease-in-out px-6 md:px-20
                ${index === currentSlide ? 'opacity-100 translate-y-0 visible delay-100' : 
                  index < currentSlide ? 'opacity-0 -translate-y-10 invisible' : 'opacity-0 translate-y-10 invisible'
                }`}
            >
              <SlideContent data={slide} />
            </div>
          ))}
        </div>
      </main>

      {/* Navigation Controls */}
      <div className="absolute bottom-8 right-8 flex gap-4 z-40">
        <button 
          onClick={prevSlide}
          disabled={currentSlide === 0}
          className="p-3 rounded-full border border-gray-200 hover:bg-black hover:text-white hover:border-black disabled:opacity-30 disabled:hover:bg-transparent disabled:hover:text-black transition-all"
        >
          <ChevronLeft size={24} />
        </button>
        <button 
          onClick={nextSlide}
          disabled={currentSlide === totalSlides - 1}
          className="p-3 rounded-full border border-gray-200 hover:bg-black hover:text-white hover:border-black disabled:opacity-30 disabled:hover:bg-transparent disabled:hover:text-black transition-all"
        >
          <ChevronRight size={24} />
        </button>
      </div>

      {/* Slide Counter */}
      <div className="absolute bottom-8 left-8 text-xs font-mono tracking-widest text-gray-400">
        {(currentSlide + 1).toString().padStart(2, '0')} — {totalSlides.toString().padStart(2, '0')}
      </div>
    </div>
  );
}

// Slide Content Component
function SlideContent({ data }) {
  const formatText = (text) => {
    return text.split('\n').map((line, i) => (
      <React.Fragment key={i}>
        {line}
        <br />
      </React.Fragment>
    ));
  };

  switch (data.type) {
    case 'title':
      return (
        <div className="max-w-4xl">
          <h1 className="text-5xl md:text-8xl font-black mb-12 leading-tight whitespace-pre-wrap">
            {data.title}
          </h1>
          <div className="h-1 w-20 bg-black mb-12" />
          <p className="text-lg md:text-xl text-gray-600 leading-relaxed max-w-2xl font-light">
            {formatText(data.sub)}
          </p>
        </div>
      );

    case 'list':
      return (
        <div className="w-full max-w-4xl">
          <h2 className="text-sm font-bold tracking-[0.2em] text-gray-400 mb-16 uppercase border-b pb-4">
            Index
          </h2>
          <ul className="space-y-8">
            {data.items.map((item, i) => (
              <li key={i} className="text-2xl md:text-4xl font-bold flex items-baseline group cursor-default">
                <span className="text-sm font-mono mr-8 text-gray-300 group-hover:text-black transition-colors">
                  {(i + 1).toString().padStart(2, '0')}
                </span>
                {item}
              </li>
            ))}
          </ul>
        </div>
      );

    case 'step':
      return (
        <div className="w-full flex flex-col md:flex-row gap-12 md:gap-24 items-start md:items-center h-full pt-20 pb-20">
          <div className="flex-shrink-0">
             <div className="text-[120px] md:text-[200px] leading-none font-black text-gray-100 select-none -ml-2 md:-ml-4">
              {data.step}
             </div>
          </div>
          <div className="flex-1">
            <h2 className="text-3xl md:text-5xl font-bold mb-10 leading-snug whitespace-pre-wrap">
              {data.title}
            </h2>
            <div className="text-lg md:text-xl text-gray-600 leading-loose font-light whitespace-pre-wrap">
              {data.content}
            </div>
          </div>
        </div>
      );

    case 'split':
      return (
        <div className="w-full">
           <span className="inline-block px-3 py-1 border border-black rounded-full text-xs font-bold mb-8 uppercase tracking-wider">
             {data.section}
           </span>
           <h2 className="text-3xl md:text-5xl font-bold mb-10">
             {data.title}
           </h2>
           <p className="text-lg md:text-xl text-gray-600 leading-loose font-light whitespace-pre-wrap max-w-3xl">
             {data.content}
           </p>
        </div>
      );

    default: // simple
      return (
        <div className="w-full max-w-4xl">
          <h2 className="text-4xl md:text-6xl font-bold mb-16 whitespace-pre-wrap">
            {data.title}
          </h2>
          <div className="text-lg md:text-xl text-gray-600 leading-loose font-light whitespace-pre-wrap">
            {data.content}
          </div>
          {data.sub && (
             <div className="mt-12 pt-12 border-t border-gray-100 text-gray-500 font-light">
               {data.sub}
             </div>
          )}
        </div>
      );
  }
}


